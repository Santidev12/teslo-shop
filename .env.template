# --- Base de datos (Supabase Postgres) ---
# Supabase > Connect > ORMs/Prisma. DATABASE_URL usa el pooler (puerto 6543) y se usa en runtime.
# DIRECT_URL usa la conexión directa/session pooler (puerto 5432) y la usa Prisma para migraciones.
DATABASE_URL=
DIRECT_URL=

# Solo para desarrollo local con docker-compose (opcional)
DB_USER=
DB_NAME=
DB_PASSWORD=

# --- Auth (Auth.js / NextAuth v5) ---
# Genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
# Contraseña del usuario admin que crea el seed (si no se define: 123456, solo para local)
SEED_ADMIN_PASSWORD=

# --- PayPal (https://developer.paypal.com/dashboard) ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_OAUTH_URL=
PAYPAL_ORDERS_URL=

# --- Cloudinary (https://console.cloudinary.com) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
